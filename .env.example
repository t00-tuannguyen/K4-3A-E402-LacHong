# Copy this file to .env locally. Do not commit an actual key.
# Choose exactly one provider. Gemini remains available for compatibility.
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=replace_with_9router_key
NINEROUTER_MODEL=cx/deepseek-chat

# Gemini alternative
# LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_google_ai_studio_key
# GOOGLE_API_KEY=replace_with_google_ai_studio_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# CORE_AI_LOG_LEVEL=INFO
