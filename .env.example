# Copy this file to .env locally. Do not commit an actual key.
# Choose exactly one provider. Any OpenAI-compatible router works here.
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=replace_with_router_key
OPENAI_MODEL=cx/deepseek-chat

# Gemini alternative
# LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_google_ai_studio_key
# GOOGLE_API_KEY=replace_with_google_ai_studio_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# CORE_AI_LOG_LEVEL=INFO

# Discord bot adapter (keep real token in local .env only)
# DISCORD_BOT_TOKEN=replace_with_discord_bot_token
# DISCORD_SERVER_ID=1550097057115541585
# DISCORD_CHANNEL_ID=1550097057820450931
# DISCORD_TA_ROLE_ID=1550098311548108823
# DISCORD_TA_USER_ID=888679823512334336
# DISCORD_BOT_NAME=Trợ lý
# CORE_AI_URL=http://localhost:8000
# DISCORD_SOURCE_MAP_JSON={}
